{
  "name": "een-oauth-proxy-root",
  "version": "1.1.0",
  "private": true,
  "description": "EEN OAuth Proxy - Monorepo root",
  "scripts": {
    "prepare": "husky",
    "test": "./scripts/run-all-tests.sh",
    "test:proxy": "cd proxy && npm test",
    "test:perf": "cd proxy && npm run test:perf",
    "test:demo": "cd demo1 && npm test",
    "test:admin": "cd admin && npm test",
    "deploy:pages": "./scripts/deploy-pages.sh",
    "deploy:proxy": "cd proxy && npm run deploy",
    "build:presentation": "node scripts/generate-presentation.js && test -f PRESENTATION.md && marp PRESENTATION.md -o PRESENTATION.html",
    "gate": "bash scripts/security-gate.sh"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7"
  }
}
