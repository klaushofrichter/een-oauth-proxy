{
  "name": "een-oauth-admin",
  "displayName": "EEN OAuth Proxy Admin",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run stop && vite",
    "dev:prod": "npm run stop && vite --mode prod",
    "stop": "lsof -ti :3333 | xargs kill -9 2>/dev/null || echo 'Port 3333 is free'",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:prod": "E2E_PROD=1 VITE_PROXY_URL=$(grep \"^VITE_PROXY_URL\" .env.prod | cut -d= -f2-) playwright test"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.3",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vitest": "^3.2.0"
  }
}
