{
  "name": "een-oauth-proxy",
  "version": "1.3.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run stop && node scripts/set-local-version.js && wrangler dev",
    "stop": "lsof -ti :8787 | xargs kill -9 2>/dev/null || echo 'Port 8787 is free'",
    "deploy": "node scripts/deploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run test/performance.test.js",
    "prepare": "cd .. && husky"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.12",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "vitest": "^3.2.0",
    "wrangler": "^4.65.0"
  }
}
